# Local: nenhuma variável é obrigatória. O primeiro acesso é criado no terminal.
APP_ENV=development
# DATA_DIR=/caminho/absoluto/para/dados
# Em produção: APP_ENV=production. Monte um volume persistente para DATA_DIR.
# Opcional em produção: chave aleatória com pelo menos 32 caracteres. Sem ela,
# o aplicativo gera uma chave no diretório de dados e a mantém entre reinícios.
SECRET_KEY=
# URL pública HTTPS, sem barra no final, depois de publicar.
PUBLIC_BASE_URL=
# Opcional: domínios permitidos separados por vírgula, sem https://.
TRUSTED_HOSTS=
# Usadas apenas na PRIMEIRA inicialização em produção. Não redefinem contas existentes.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_WHATSAPP=
ADMIN_PASSWORD=
